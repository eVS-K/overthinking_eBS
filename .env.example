# Backend-origin Ranked/Auth application. Keep this file as examples only;
# never commit real credentials or production database URLs.
NODE_ENV=production
PORT=3000

APP_ORIGIN=https://overthinking-ebs.onrender.com
ALLOWED_ORIGINS=https://evs-k.github.io,https://overthinking-ebs.onrender.com
# Enable only for the Render public Web Service. When enabled, the server
# accepts only Cloudflare's single CF-Connecting-IP header, never a client
# supplied X-Forwarded-For chain. Do not enable for a directly exposed server.
TRUST_PROXY=true
TRUSTED_PROXY_IP_HEADER=cf-connecting-ip

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# DATABASE_SSL defaults to certificate verification in production.
# DATABASE_QUERY_TIMEOUT_MS=8000

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Bound token/user lookups so an unavailable identity provider cannot occupy a worker.
# SUPABASE_REQUEST_TIMEOUT_MS=8000

# 32 bytes, encoded as base64 or 64 hexadecimal characters. Generate a value
# once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RANKED_SEED_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_SECRET

# Optional operational overrides.
# RANKED_TURN_TIME_LIMIT_MS=90000 # Rounds 1–6 only; final round is always 15000 ms.
# RANKED_ABANDON_AFTER_MS=86400000
# SESSION_ABSOLUTE_MS=2592000000
# SESSION_IDLE_MS=604800000

# Guest random-match safety bounds. These are intentionally conservative;
# increase only after confirming capacity at the deployment edge.
# MAX_RANDOM_MATCH_QUEUE=300
# MAX_RANDOM_QUEUE_PER_IP=3
# RANDOM_MATCH_REQUEST_LIMIT=18
# Private rooms that are waiting for start consent, or left on the result
# screen, are reclaimed after this inactivity window. Active games are never
# expired by this setting.
# PRIVATE_ROOM_IDLE_TTL_MS=900000
# MAX_PRIVATE_ROOMS_PER_IP=3
